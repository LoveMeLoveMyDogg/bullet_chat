# 复制为 deploy.env 并填写真实值（deploy.env 不入库，勿提交真实凭据）
# DEPLOY_HOST：更新服务器 IP 或域名（如 139.196.204.73）
# DEPLOY_USER：SSH 登录用户（如 root）
# DEPLOY_SSH_KEY：SSH 私钥文件路径
#   - macOS 示例：/Users/你的用户名/.ssh/calories-server-key.pem
#   - Windows 示例：C:\Users\你的用户名\.ssh\calories-server-key.pem
# DEPLOY_PATH：服务器上更新站点的静态根目录
DEPLOY_HOST=your-server-ip
DEPLOY_USER=root
DEPLOY_SSH_KEY=/path/to/your-ssh-key.pem
DEPLOY_PATH=/www/wwwroot/updates.zhipengcoding.com
